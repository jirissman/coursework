FS.pca <- function(data.fs, fn){
pc <- prcomp(data.fs[, -length(data.fs)], center = TRUE, scale = TRUE) # exclude class attribute
print(summary(pc))
# first map (project) original attributes to new attributes created by PCA
tr <- predict(pc, data.fs)
tr <- data.frame(tr, data.fs[length(data.fs)])
ts <- predict(pc, test)
ts <- data.frame(ts, test[length(data.fs)])
pca <- tr[c(1:7, length(data.fs))]
write.csv(pca, file = paste("Project_train_", fn,"_data_PCA.csv" , sep = ""),
row.names = FALSE)
table(pca$Class)
}
FS.pca(oversampling_data, "oversampled")
FS.pca(undersampling_data, "undersampled")
