#
# train.df <- read.csv("Project_train_SMOTE_data_Gain_Ratio.csv")
# train.df$Class <- factor(train.df$Class)
# test <- read.csv("./Project/initial_test.csv")
# test$Class <- factor(test$Class)
#
# set.seed(31)
# # repeat 10-fold cross-validation 5 times
# train_control <- trainControl(method = "repeatedcv",
#                               number = 10,
#                               repeats = 5,
#                               summaryFunction = defaultSummary,
#                               classProbs =  TRUE)
#
#
# svmGrid <-  expand.grid(sigma = seq(0.1, 0.4, by = 0.05), C = seq(1.0, 2.0, by = 0.1))
#
# model <- caret::train(Class ~ ., data = train.df, method = "svmRadial",
#                       preProc = c("center", "scale"),
#                       trControl = train_control, tuneGrid = svmGrid)
# model
# plot(model)
#
# pred <- predict(model, test)
# cm <- caret::confusionMatrix(pred, test$Class)
# cm
#
#
# # ROC using pROC newdata = test %>% select(-Class)
# gc_prob <- predict(model, test, type = "prob")
# gc_pROC <- roc(response = test$Class, predictor = gc_prob[, "N"])
# plot(gc_pROC, main =paste("ROC curve\n", "zz"), print.auc=TRUE)
# gc_pROC$auc
#
#
# # Accuracy was used to select the optimal model using the largest value.
# # The final values used for the model were sigma = 0.4 and C = 2.
model.svm <- function(train.df, test, fileName, sigma =0.4, C=2, mainDir=working.dir){
subDir <- "SVM"
set.seed(31)
# repeat 10-fold cross-validation 5 times
train_control <- trainControl(method = "repeatedcv",
number = 10,
repeats = 5,
summaryFunction = defaultSummary,
classProbs =  TRUE)
# svmGrid <-  expand.grid(sigma = seq(0.1, 0.4, by = 0.05), C = seq(1.0, 2.0, by = 0.1))
svmGrid <- data.frame(sigma = sigma, C = C)
svmModel <- caret::train(Class ~ .,
data = train.df,
method = "svmRadial",
preProc = c("center", "scale"),
trControl = train_control,
tuneGrid = svmGrid)
pred <- predict(svmModel, newdata = test)
cat("svmModel$bestTune \n")
print(svmModel$bestTune)
############      Start from here the rest of code for performance measurement      ############
performance_measures.Y  <- caret::confusionMatrix(pred, test$Class)
# print(performance_measures.Y)
cm <- performance_measures.Y$table
print(cm)
tp = cm[2,2]
fp = cm[2,1]
tn = cm[1,1]
fn = cm[1,2]
############      ROC ploting and AUC        ###############
## ROC area
SVMprob <- predict(svmModel, test, type = "prob")
SVMROC <- roc(response = test$Class, predictor = SVMprob[, "N"])
roc_area <- SVMROC$auc
dir.create(file.path(mainDir, subDir), showWarnings = FALSE)
setwd(file.path(mainDir, subDir))
png(
paste("ROC_svm_",substr(fileName, 11, nchar(fileName)-4),".png",sep = ""),
width     = 2.25,
height    = 2.25,
units     = "in",
res       = 2400,
pointsize = 4.5
)
plot(SVMROC, main =paste("ROC curve\n", fileName), print.auc=TRUE)
dev.off()
############      output performance stat        ###########
performance.stat(tp, fp, tn, fn, roc_area)
}
# Loop through the different training data sets
for ( fn in Files){
setwd(working.dir)
cat("\n")
cat(fn)
cat("\n")
train.df <- read.csv(fn)
train.df$Class <- factor(train.df$Class)
performance <- model.svm(train.df, test, fn, sigma =0.4, C=2.0)
}
################       Model training #6  random.forest         ##############
########   Tune parameter using SMOTE_data_Gain_Ratio features  ########
########    Comment out  for the full modeling                  ########
#
# setwd(working.dir)
# train.df <- read.csv("Project_train_SMOTE_data_Gain_Ratio.csv")
# train.df$Class <- factor(train.df$Class)
#
#
# set.seed(31)
# # repeat 10-fold cross-validation 5
# train_control <- trainControl(method = "CV",
#                               summaryFunction = twoClassSummary,
#                               classProbs = TRUE,
#                               savePredictions = TRUE)
#
# mtryValues <- seq(2, ncol(train.df)-1, by = 1)
#
# set.seed(31)
# rfFit <- caret::train(x = train.df[, -length(train.df)],
#                       y = train.df$Class,
#                       method = "rf",
#                       ntree = 500,
#                       tuneGrid = data.frame(mtry = mtryValues),
#                       importance = TRUE,
#                       metric = "ROC",
#                       trControl = train_control)
#
#
# # mtry = 2. is the best parameter !!!!
#
# rfFit
# plot(rfFit)
#
# # saveRDS(rfFit, "rfFit.rds")
# # my_model <- readRDS("model.rds")
random.forest <- function(train.df, test, fileName, mtryValue=2, mainDir=working.dir){
subDir <- "random.forest"
set.seed(31)
# repeat 10-fold cross-validation 5
train_control <- trainControl(method = "CV",
summaryFunction = twoClassSummary,
classProbs = TRUE,
savePredictions = TRUE)
mtryValues <- seq(2, ncol(train.df)-1, by = 1)
rfFit <- caret::train(x = train.df[, -length(train.df)],
y = train.df$Class,
method = "rf",
ntree = 500,
tuneGrid = data.frame(mtry = mtryValue),
importance = TRUE,
metric = "ROC",
trControl = train_control)
pred <- predict(rfFit, test)
cat("rfFit$bestTune \n")
print(rfFit$bestTune)
############      Start from here the rest of code for performance measurement      ############
performance_measures.Y  <- caret::confusionMatrix(pred, test$Class)
# print(performance_measures.Y)
cm <- performance_measures.Y$table
print(cm)
tp = cm[2,2]
fp = cm[2,1]
tn = cm[1,1]
fn = cm[1,2]
############      ROC ploting and AUC        ###############
## ROC area
rfRoc <- roc(response = rfFit$pred$obs,
predictor = rfFit$pred$Y,
levels = rev(levels(rfFit$pred$obs)))
roc_area <- rfRoc$auc
dir.create(file.path(mainDir, subDir), showWarnings = FALSE)
setwd(file.path(mainDir, subDir))
png(
paste("ROC_randomForest_",substr(fileName, 11, nchar(fileName)-4),".png",sep = ""),
width     = 2.25,
height    = 2.25,
units     = "in",
res       = 2400,
pointsize = 4.5
)
plot(rfRoc, main ="ROC curve", print.auc=TRUE)
dev.off()
############      output performance stat        ###########
performance.stat(tp, fp, tn, fn, roc_area)
## variable importance
imp <- varImp(rfFit)
print(imp)
}
# Loop through the different training data sets
for ( fn in Files){
setwd(working.dir)
cat("\n")
cat(fn)
cat("\n")
train.df <- read.csv(fn)
train.df$Class <- factor(train.df$Class)
performance <- random.forest(train.df, test, fn, 2)
}
