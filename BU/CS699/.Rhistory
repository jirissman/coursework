# mine frequent itemsets
# default: min. support = 0.1, min. confidence = 0.8, maxlen = 10. maxtime = 5 sec
L <- apriori(df, support =0.04, target = "frequent itemsets")
summary(L)
inspect(L)
L.sorted <- sort(L, by = "support")
inspect(L.sorted)
# X is maximal frequent itemset if there is no proper superset Y that is frequent
# X is a closed itemset if there is not proper superset Y s.t. sup(X) = sup(Y)
# X is a closed frequent itemset if X is closed and frquent
# all maximal frequent itemsets are also closed
# not all closed frequent itemsets are maximal
L.max <- L[is.maximal(L)]
inspect(L.max)
L.closed <- L[is.closed(L)]
inspect(L.closed)
L_df <- as(L, "data.frame")
L_df[L_df$items=="{Milk}", ]
