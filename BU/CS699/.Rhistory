fnr = fn / (fn + tp)
precision = tp / (tp + fp)
recall = tpr
f_measure <- (2 * precision * recall) / (precision + recall)
mcc <- (tp*tn - fp*fn)/(sqrt(tp+fp)*sqrt(tp+fn)*sqrt(tn+fp)*sqrt(tn+fn))
total = (tp + fn + fp + tn)
p_o = (tp + tn) / total
p_e1 = ((tp + fn) / total) * ((tp + fp) / total)
p_e2 = ((fp + tn) / total) * ((fn + tn) / total)
p_e = p_e1 + p_e2
k = (p_o - p_e) / (1 - p_e)
# class N
tp.N = tn
fp.N = fn
tn.N = tp
fn.N = fp
tpr.N = tp.N / (tp.N + fn.N)
fpr.N = fp.N / (fp.N + tn.N)
tnr.N = tn.N / (fp.N + tn.N)
fnr.N = fn.N / (fn.N + tp.N)
precision.N = tp.N / (tp.N + fp.N)
recall.N = tpr.N
f_measure.N <- (2 * precision.N * recall.N) / (precision.N + recall.N)
mcc.N <- (tp.N*tn.N - fp.N*fn.N)/(sqrt(tp.N+fp.N)*sqrt(tp.N+fn.N)*sqrt(tn.N+fp.N)*sqrt(tn.N+fn.N))
p_o.N = (tp.N + tn.N) / total
p_e1.N = ((tp.N + fn.N) / total) * ((tp.N + fp.N) / total)
p_e2.N = ((fp.N + tn.N) / total) * ((fn.N + tn.N) / total)
p_e.N = p_e1.N + p_e2.N
k.N = (p_o.N - p_e.N) / (1 - p_e.N)
true.wt = (tp + fn)/total
flse.wt = (fp + tn)/total
measures <- c('TPR', 'FPR', 'Precision', 'Recall', 'F-measure', "ROC", 'MCC', 'Kappa')
values <- c(tpr, fpr,  precision, recall, f_measure, roc_area, mcc, k)
values.N <- c(tpr.N, fpr.N,  precision.N, recall.N, f_measure.N, roc_area, mcc.N, k.N)
wt.average <- c(true.wt*tpr + flse.wt*tpr.N,
# true.wt*tnr + flse.wt*tnr.N,
true.wt*fpr + flse.wt*fpr.N,
true.wt*precision + flse.wt*precision.N,
true.wt*recall + flse.wt*recall.N,
true.wt*f_measure + flse.wt*f_measure.N,
true.wt*roc_area + flse.wt*roc_area,
true.wt*mcc + flse.wt*mcc.N,
true.wt*k + flse.wt*k.N)
measure.df.Y <- data.frame(measures, values, values.N, wt.average)
cat("measure.df.Y\n")
print(measure.df.Y)
}
