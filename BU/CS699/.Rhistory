################       Model training # 1 naive bayes          ##############
naive.bayes <- function(train.df, test, fileName, mainDir=working.dir){
subDir <- "naive.bayes"
# print(sapply(train.df, class))
model.nb <- naiveBayes(Class ~ ., data = train.df)
pred <- predict(model.nb, newdata = test, type = "class")
############      Start from here the rest of code for performance measurement      ############
performance_measures.Y  <- confusionMatrix(data=pred,
reference = test$Class, positive = "Y" )
# print(performance_measures.Y)
cm <- performance_measures.Y$table
print(cm)
tp = cm[2,2]
fp = cm[2,1]
tn = cm[1,1]
fn = cm[1,2]
############      ROC ploting and AUC        ###############
pred.raw <- predict(model.nb, newdata = test, type = "raw")
pred.raw <- data.frame(pred.raw)
pred_perf <- prediction(predictions = pred.raw$Y, labels = test$Class)
# performance {ROCR}, Function to create performance objects
roc <- performance(pred_perf, measure="tpr", x.measure = "fpr")
# png(paste("ROC_",fileName, ".png"), width = 500, height = 500)
roc_area = performance(pred_perf, measure = "auc")
roc_area <- roc_area@y.values[[1]]
dir.create(file.path(mainDir, subDir), showWarnings = FALSE)
setwd(file.path(mainDir, subDir))
png(
paste("ROC_NaiveBayes_",substr(fileName, 11, nchar(fileName)-4),".png",sep = ""),
width     = 2.25,
height    = 2.25,
units     = "in",
res       = 2400,
pointsize = 4.5
)
par(
mar      = c(6, 6, 8, 6),
xaxs     = "i",
yaxs     = "i",
cex.axis = 1.5,
cex.lab  = 1.5
)
plot(roc, main = paste("ROC: ",fileName)) + abline(a=0, b= 1)
mysubtitle = paste("AUC: ", sprintf("%0.3f", roc_area))
mtext(side=3, line=2, at=0.4, adj=0, cex=1, mysubtitle)
dev.off()
############      output performance stat        ###########
performance.stat(tp, fp, tn, fn, roc_area)
}
# Loop through the different training data sets
for ( fn in Files){
setwd(working.dir)
cat("\n")
cat(fn)
cat("\n")
train.df <- read.csv(fn)
train.df$Class <- factor(train.df$Class)
performance <- naive.bayes(train.df, test, fn)
}
################       Model training # 2   logistic.reg        ##############
logistic.reg <- function(train.df, test, fileName, mainDir=working.dir){
subDir <- "logistic.reg"
set.seed(31)
# run logistic regression
# use glm() (generalized linear model) with family = "binomial"
logitModel <- glm(Class ~ ., data = train.df, family = "binomial")
# disable scientific notation
options(scipen=999)
summary(logitModel)
# use predict() with type = "response" to compute predicted probabilities.
logitModel.pred <- predict(logitModel, test[, -length(test)], type = "response")
# performance measures on the test dataset
pred <- factor(ifelse(logitModel.pred >= 0.5, 1, 0))
############      Start from here the rest of code for performance measurement      ############
performance_measures  <- confusionMatrix(data=pred,
reference = test$Class)
cm <- performance_measures$table
print(cm)
tp = cm[2,2]
fp = cm[2,1]
tn = cm[1,1]
fn = cm[1,2]
############      ROC ploting and AUC        ###############
## ROC area
rocobj=roc(test$Class, logitModel.pred)
roc_area <- rocobj$auc
dir.create(file.path(mainDir, subDir), showWarnings = FALSE)
setwd(file.path(mainDir, subDir))
png(
paste("ROC_LogReg_",substr(fileName, 11, nchar(fileName)-4),".png",sep = ""),
width     = 2.25,
height    = 2.25,
units     = "in",
res       = 2400,
pointsize = 4.5
)
plot(rocobj, main ="ROC curve", print.auc=TRUE)
dev.off()
############      output performance stat        ###########
performance.stat(tp, fp, tn, fn, roc_area)
## variable importance
x <- varImp(logitModel)
x
imp <- data.frame(varImp(logitModel))
imp <- data.frame(names   = rownames(imp),
overall = imp$Overall)
cat("\n")
print(imp[order(imp$overall,decreasing = T), ])
}
# Loop through the different training data sets
for ( fn in Files){
setwd(working.dir)
cat("\n")
cat(fn)
cat("\n")
train.df <- read.csv(fn)
train.df <- train.df %>%
mutate(Class = ifelse(Class == "N",0,1))
train.df$Class <- factor(train.df$Class)
test <- read.csv("./Project/initial_test.csv")
test <- test %>%
mutate(Class = ifelse(Class == "N",0,1))
test$Class <- factor(test$Class)
performance <- logistic.reg(train.df, test, fn)
}
################       Model training # 3 KNN           ##############
knn.model <- function(train.df, test, fileName, kValue=1, mainDir=working.dir){
subDir <- "KNN"
set.seed(31)
# knnModel <- train(Class ~., data = train.df, method = "knn",
#                   trControl = trainControl(method = "none"),
#                   preProcess = c("center", "scale"),
#                   tuneGrid = data.frame( k = kValue))
# # repeat 10-fold cross-validation 5 times
train_control <- trainControl(method = "repeatedcv", number = 10, repeats = 5,
summaryFunction = defaultSummary)
knnGrid <-  expand.grid(k = seq(1, 20, 2))
knnModel <- train(Class ~., data = train.df, method = "knn",
trControl=train_control,
preProcess = c("center", "scale"),
tuneGrid = knnGrid)
cat("knnModel$bestTune \n")
print(knnModel$bestTune)
pred <- predict(knnModel, test)
############      Start from here the rest of code for performance measurement      ############
performance_measures.Y  <- confusionMatrix(data=pred,
reference = test$Class, positive = "Y" )
cm <- performance_measures.Y$table
print(cm)
tp = cm[2,2]
fp = cm[2,1]
tn = cm[1,1]
fn = cm[1,2]
############      ROC ploting and AUC        ###############
## ROC area
knnPredict <- predict(knnModel, test , type="prob")
knnROC <- roc(test$Class,
knnPredict[,"N"],
levels = rev(levels(test$Class)))
roc_area <- knnROC$auc
dir.create(file.path(mainDir, subDir), showWarnings = FALSE)
setwd(file.path(mainDir, subDir))
png(
paste("ROC_KNN_",substr(fileName, 11, nchar(fileName)-4),".png",sep = ""),
width     = 2.25,
height    = 2.25,
units     = "in",
res       = 2400,
pointsize = 4.5
)
plot(knnROC, main ="ROC curve", print.auc=TRUE)
dev.off()
############      output performance stat        ###########
performance.stat(tp, fp, tn, fn, roc_area)
}
# Loop through the different training data sets
for ( fn in Files){
setwd(working.dir)
cat("\n")
cat(fn)
cat("\n")
train.df <- read.csv(fn)
train.df$Class <- factor(train.df$Class)
test <- read.csv("./Project/initial_test.csv")
test$Class <- factor(test$Class)
performance <- knn.model(train.df, test, fn, kValue=1)
}
################       Model training # 4 gradient.Boost           ##############
gradient.Boost <- function(train.df, test, fileName, mainDir=working.dir){
subDir <- "GradientBoost"
set.seed(31)
# repeat 10-fold cross-validation 5
train_control <- trainControl(method = "CV",
summaryFunction = twoClassSummary,
classProbs = TRUE,
savePredictions = TRUE)
gbmGrid <- expand.grid(interaction.depth = c(1, 3, 5, 7, 9),
n.trees = (2:10)*10,
shrinkage = c(.001, .01),
n.minobsinnode = 3)
set.seed(31)
gbmFit <- caret::train(x = train.df[, -length(train.df)],
y = train.df$Class,
method = "gbm",
tuneGrid = gbmGrid,
metric = "ROC",
verbose = FALSE,
trControl = train_control)
pred <- predict(gbmFit, test)
cat("gbmFit$bestTune \n")
print(gbmFit$bestTune)
############      Start from here the rest of code for performance measurement      ############
performance_measures.Y  <- caret::confusionMatrix(pred, test$Class)
# print(performance_measures.Y)
cm <- performance_measures.Y$table
print(cm)
tp = cm[2,2]
fp = cm[2,1]
tn = cm[1,1]
fn = cm[1,2]
############      ROC ploting and AUC        ###############
## ROC area
gbmRoc <- roc(response = gbmFit$pred$obs,
predictor = gbmFit$pred$Y,
levels = rev(levels(gbmFit$pred$obs)))
roc_area <- gbmRoc$auc
dir.create(file.path(mainDir, subDir), showWarnings = FALSE)
setwd(file.path(mainDir, subDir))
png(
paste("ROC_randomForest_",substr(fileName, 11, nchar(fileName)-4),".png",sep = ""),
width     = 2.25,
height    = 2.25,
units     = "in",
res       = 2400,
pointsize = 4.5
)
plot(gbmRoc, main ="ROC curve", print.auc=TRUE)
# mysubtitle = paste(fileName)
# mtext(side=3, line=2, at=0.1, adj=1, cex=1, mysubtitle)
dev.off()
############      output performance stat        ###########
performance.stat(tp, fp, tn, fn, roc_area)
}
# Loop through the different training data sets
for ( fn in Files){
setwd(working.dir)
cat("\n")
cat(fn)
cat("\n")
train.df <- read.csv(fn)
train.df$Class <- factor(train.df$Class)
performance <- gradient.Boost(train.df, test, fn)
}
