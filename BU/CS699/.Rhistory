colnames(smote)[which(names(smote) == "class")] <- "Class"
smote$Class <- factor(smote$Class)
table (smote$Class)
write.csv(smote, file = "Project_train_smote.csv", row.names = FALSE)
barplot(prop.table(table(smote$Class)),
col = rainbow(2),
ylim = c(0, 1.0),
main = "Class Distribution: train after SMOTE")
