# read data frame
p4.df <- read.csv('hw9_p4.csv')
head(p4.df)
sapply(df, class)
df <- as.data.frame(unclass(df), stringsAsFactors = TRUE)
sapply(df, class)
head(p4.df)
sapply(p4.df, class)
p4.df <- as.data.frame(unclass(p4.df), stringsAsFactors = TRUE)
sapply(p4.df, class)
gower_dist <- daisy(p4.df, metric = "gower")
pam_4 <- pam(gower_dist, diss = TRUE, k = 2:10)
for (clusters in 2:10) {
pam_clusters <- pam(gower_dist, diss = TRUE, k = clusters)
}
pam_4 <- pam(gower_dist, diss = TRUE, k = 4)
sil_width <- c(NA)
for(i in 2:20){
pam_k <- pam(gower_dist, diss = TRUE, k = i)
sil_width[i] <- pam_k$silinfo$avg.width
}
for(i in 2:10){
pam_k <- pam(gower_dist, diss = TRUE, k = i)
sil_width[i] <- pam_k$silinfo$avg.width
}
best_k <- which.max(sil_width)
best_k
plot(1:10, sil_width, xlab = "Number of clusters",
ylab = "Silhouette Width")
