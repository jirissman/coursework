######################################################## 
#######    chi.squared                           ####### 
######################################################## 
FS.chi.squared <- function(data.fs, fn){
  weights <- chi.squared(Class~., data.fs) 
  print(weights) 
  
  subset <- cutoff.k(weights, 7) 
  f <- as.simple.formula(subset, "Class") 
  print(f)
  
  chi.squared.df <- data.fs[, c(subset, "Class")]
  
  write.csv(chi.squared.df, file = paste("Project_train_", fn,"_data_chiSquared.csv" , sep = ""), 
            row.names = FALSE)
  table(chi.squared.df$Class)
}

FS.chi.squared(undersampling_data, "undersampled")
FS.chi.squared(oversampling_data, "oversampled")
FS.chi.squared(smote, "SMOTE")

