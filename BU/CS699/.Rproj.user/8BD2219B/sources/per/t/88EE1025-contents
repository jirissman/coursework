gradient.Boost <- function(train.df, test, fileName, mainDir=working.dir){
  subDir <- "GradientBoost"
  
  set.seed(31)
  # repeat 10-fold cross-validation 5 
  train_control <- trainControl(method = "CV",
                                summaryFunction = twoClassSummary,
                                classProbs = TRUE,
                                savePredictions = TRUE)
  
  
  gbmGrid <- expand.grid(interaction.depth = c(4, 6, 8, 10),
                         n.trees = (2:10)*10,
                         shrinkage = c(.01, 0.1),
                         n.minobsinnode = 3)
  
  set.seed(31)
  gbmFit <- caret::train(x = train.df[, -length(train.df)], 
                         y = train.df$Class,
                         method = "gbm",
                         tuneGrid = gbmGrid,
                         metric = "ROC",
                         verbose = FALSE,
                         trControl = train_control)
  
  
  pred <- predict(gbmFit, test)
  
  cat("gbmFit$bestTune \n")
  print(gbmFit$bestTune)
  

  ############      Start from here the rest of code for performance measurement      ############          
  
  
  performance_measures.Y  <- caret::confusionMatrix(pred, test$Class)
  
  # print(performance_measures.Y)
  cm <- performance_measures.Y$table
  
  print(cm)
  
  tp = cm[2,2]
  fp = cm[2,1]
  tn = cm[1,1]
  fn = cm[1,2]
  

  ############      ROC ploting and AUC        ###############

  ## ROC area
  gbmRoc <- roc(response = gbmFit$pred$obs,
                predictor = gbmFit$pred$Y,
                levels = rev(levels(gbmFit$pred$obs)))
  roc_area <- gbmRoc$auc
  
  dir.create(file.path(mainDir, subDir), showWarnings = FALSE)
  setwd(file.path(mainDir, subDir))
  
  png(
    paste("ROC_randomForest_",substr(fileName, 11, nchar(fileName)-4),".png",sep = ""),
    width     = 2.25,
    height    = 2.25,
    units     = "in",
    res       = 2400,
    pointsize = 4.5
  )
  
  plot(gbmRoc, main ="ROC curve", print.auc=TRUE)
  # mysubtitle = paste(fileName)
  # mtext(side=3, line=2, at=0.1, adj=1, cex=1, mysubtitle)
  
  dev.off()
  

  ############      output performance stat        ###########

  
  performance.stat(tp, fp, tn, fn, roc_area)
}
  
