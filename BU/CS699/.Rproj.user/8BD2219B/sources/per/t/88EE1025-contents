random.forest <- function(train.df, test, fileName, mtryValue=2, mainDir=working.dir){
  
  subDir <- "random.forest"
  
  set.seed(31)
  # repeat 10-fold cross-validation 5 
  train_control <- trainControl(method = "CV",
                                summaryFunction = twoClassSummary,
                                classProbs = TRUE,
                                savePredictions = TRUE)
  
  mtryValues <- seq(2, ncol(train.df)-1, by = 1)
  
  rfFit <- caret::train(x = train.df[, -length(train.df)], 
                        y = train.df$Class,
                        method = "rf",
                        ntree = 500,
                        tuneGrid = data.frame(mtry = mtryValue),
                        importance = TRUE,
                        metric = "ROC",
                        trControl = train_control)
  
  pred <- predict(rfFit, test)
  
  cat("rfFit$bestTune \n")
  print(rfFit$bestTune)
  
  ############      Start from here the rest of code for performance measurement      ############          
  
  
  performance_measures.Y  <- caret::confusionMatrix(pred, test$Class)
  
  # print(performance_measures.Y)
  cm <- performance_measures.Y$table
  
  print(cm)
  
  tp = cm[2,2]
  fp = cm[2,1]
  tn = cm[1,1]
  fn = cm[1,2]
  
  ############      ROC ploting and AUC        ###############
  ## ROC area
  rfRoc <- roc(response = rfFit$pred$obs,
               predictor = rfFit$pred$Y,
               levels = rev(levels(rfFit$pred$obs)))
  
  roc_area <- rfRoc$auc
  
  dir.create(file.path(mainDir, subDir), showWarnings = FALSE)
  setwd(file.path(mainDir, subDir))
  
  
  png(
    paste("ROC_randomForest_",substr(fileName, 11, nchar(fileName)-4),".png",sep = ""),
    width     = 2.25,
    height    = 2.25,
    units     = "in",
    res       = 2400,
    pointsize = 4.5
  )
  
  plot(rfRoc, main ="ROC curve", print.auc=TRUE)
  
  dev.off()
  
  ############      output performance stat        ###########
  
  performance.stat(tp, fp, tn, fn, roc_area)
  
  ## variable importance
  imp <- varImp(rfFit)
  print(imp)
}

