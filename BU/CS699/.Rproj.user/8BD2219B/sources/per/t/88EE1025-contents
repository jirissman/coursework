logistic.reg <- function(train.df, test, fileName, mainDir=working.dir){
  subDir <- "logistic.reg"
  
  set.seed(31)
  
  # run logistic regression
  # use glm() (generalized linear model) with family = "binomial" 
  logitModel <- glm(Class ~ ., data = train.df, family = "binomial") 
  # disable scientific notation
  options(scipen=999)
  summary(logitModel)
  
  # use predict() with type = "response" to compute predicted probabilities. 
  logitModel.pred <- predict(logitModel, test[, -length(test)], type = "response")
  
  # performance measures on the test dataset
  pred <- factor(ifelse(logitModel.pred >= 0.5, 1, 0))
  

  ############      Start from here the rest of code for performance measurement      ############          
  
  performance_measures  <- confusionMatrix(data=pred, 
                                           reference = test$Class)
  
  cm <- performance_measures$table
  
  print(cm)
  
  tp = cm[2,2]
  fp = cm[2,1]
  tn = cm[1,1]
  fn = cm[1,2]


  ############      ROC ploting and AUC        ###############

  
  ## ROC area
  rocobj=roc(test$Class, logitModel.pred) 
  roc_area <- rocobj$auc
  
  dir.create(file.path(mainDir, subDir), showWarnings = FALSE)
  setwd(file.path(mainDir, subDir))
  
  png(
    paste("ROC_LogReg_",substr(fileName, 11, nchar(fileName)-4),".png",sep = ""),
    width     = 2.25,
    height    = 2.25,
    units     = "in",
    res       = 2400,
    pointsize = 4.5
  )
  
  plot(rocobj, main ="ROC curve", print.auc=TRUE)
  
  dev.off()
  
  ############      output performance stat        ###########
  
  performance.stat(tp, fp, tn, fn, roc_area)
  
  ## variable importance
  x <- varImp(logitModel)
  x
  imp <- data.frame(varImp(logitModel))
  imp <- data.frame(names   = rownames(imp),
                    overall = imp$Overall)
  cat("\n")
  print(imp[order(imp$overall,decreasing = T), ])
}


