knn.model <- function(train.df, test, fileName, kValue=1, mainDir=working.dir){
  subDir <- "KNN"
  
  set.seed(31)
  
  # knnModel <- train(Class ~., data = train.df, method = "knn",
  #                   trControl = trainControl(method = "none"),
  #                   preProcess = c("center", "scale"),
  #                   tuneGrid = data.frame( k = kValue))
  
  # # repeat 10-fold cross-validation 5 times
  train_control <- trainControl(method = "repeatedcv", number = 10, repeats = 5,
                                summaryFunction = defaultSummary)

  knnGrid <-  expand.grid(k = seq(1, 20, 2))
  knnModel <- train(Class ~., data = train.df, method = "knn",
                    trControl=train_control,
                    preProcess = c("center", "scale"),
                    tuneGrid = knnGrid)
  
  cat("knnModel$bestTune \n")
  print(knnModel$bestTune)
  pred <- predict(knnModel, test)
  

  ############      Start from here the rest of code for performance measurement      ############          
  
  performance_measures.Y  <- confusionMatrix(data=pred, 
                                             reference = test$Class, positive = "Y" )

  cm <- performance_measures.Y$table
  
  print(cm)
  
  tp = cm[2,2]
  fp = cm[2,1]
  tn = cm[1,1]
  fn = cm[1,2]
  
  
  ############      ROC ploting and AUC        ###############

  
  ## ROC area
  
  knnPredict <- predict(knnModel, test , type="prob")
  knnROC <- roc(test$Class, 
                knnPredict[,"N"], 
                levels = rev(levels(test$Class)))
  
  roc_area <- knnROC$auc
  
  dir.create(file.path(mainDir, subDir), showWarnings = FALSE)
  setwd(file.path(mainDir, subDir))
  
  png(
    paste("ROC_KNN_",substr(fileName, 11, nchar(fileName)-4),".png",sep = ""),
    width     = 2.25,
    height    = 2.25,
    units     = "in",
    res       = 2400,
    pointsize = 4.5
