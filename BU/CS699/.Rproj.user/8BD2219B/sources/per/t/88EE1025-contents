model.svm <- function(train.df, test, fileName, sigma =0.4, C=2, mainDir=working.dir){
  subDir <- "SVM"
  
  set.seed(31)
  
  # repeat 10-fold cross-validation 5 times
  train_control <- trainControl(method = "repeatedcv", 
                                number = 10, 
                                repeats = 5, 
                                summaryFunction = defaultSummary,
                                classProbs =  TRUE)
  
  # svmGrid <-  expand.grid(sigma = seq(0.1, 0.4, by = 0.05), C = seq(1.0, 2.0, by = 0.1))
  svmGrid <- data.frame(sigma = sigma, C = C)
  svmModel <- caret::train(Class ~ ., 
                           data = train.df, 
                           method = "svmRadial",
                           preProc = c("center", "scale"),
                           trControl = train_control, 
                           tuneGrid = svmGrid)
  
  
  pred <- predict(svmModel, newdata = test)
  
  cat("svmModel$bestTune \n")
  print(svmModel$bestTune)
  
  ############      Start from here the rest of code for performance measurement      ############          
  
