################       Model training # 1 naive bayes          ##############


naive.bayes <- function(train.df, test, fileName, mainDir=working.dir){
  subDir <- "naive.bayes"
  
  # print(sapply(train.df, class))
  model.nb <- naiveBayes(Class ~ ., data = train.df)
  pred <- predict(model.nb, newdata = test, type = "class")
  
  
  ############      Start from here the rest of code for performance measurement      ############          

  performance_measures.Y  <- confusionMatrix(data=pred, 
                                             reference = test$Class, positive = "Y" )
  # print(performance_measures.Y)
  cm <- performance_measures.Y$table
  print(cm)
  
  tp = cm[2,2]
  fp = cm[2,1]
  tn = cm[1,1]
  fn = cm[1,2]
  

  ############      ROC ploting and AUC        ###############
  
  pred.raw <- predict(model.nb, newdata = test, type = "raw")
  pred.raw <- data.frame(pred.raw)
  
  pred_perf <- prediction(predictions = pred.raw$Y, labels = test$Class)  
  
  # performance {ROCR}, Function to create performance objects
  roc <- performance(pred_perf, measure="tpr", x.measure = "fpr")
  
  # png(paste("ROC_",fileName, ".png"), width = 500, height = 500)
  
  roc_area = performance(pred_perf, measure = "auc")
  roc_area <- roc_area@y.values[[1]]
  
  dir.create(file.path(mainDir, subDir), showWarnings = FALSE)
  setwd(file.path(mainDir, subDir))

  png(
    paste("ROC_NaiveBayes_",substr(fileName, 11, nchar(fileName)-4),".png",sep = ""),
    width     = 2.25,
    height    = 2.25,
    units     = "in",
    res       = 2400,
    pointsize = 4.5
  )
  par(
    mar      = c(6, 6, 8, 6),
    xaxs     = "i",
    yaxs     = "i",
    cex.axis = 1.5,
    cex.lab  = 1.5
  )
  plot(roc, main = paste("ROC: ",fileName)) + abline(a=0, b= 1)
  mysubtitle = paste("AUC: ", sprintf("%0.3f", roc_area)) 
  mtext(side=3, line=2, at=0.4, adj=0, cex=1, mysubtitle)
  
  dev.off()

  ############      output performance stat        ###########
  
  performance.stat(tp, fp, tn, fn, roc_area)
}

