## recommendation
#############################################################################

library(recommenderlab)

load(file = "MovieLensRatings.rda")
load(file = "MovieLensMovies.rda")

ratings <- MovieLensRatings
movies <- MovieLensMovies
head(ratings)
head(movies)

# convert ratings to rating matrix
idxUserId <- sort(unique(ratings$userId))
idxMovieId <- sort(unique(ratings$movieId))
m <- matrix(NA, nrow=length(idxUserId), ncol=length(idxMovieId),
            dimnames=list(
              user=paste("u", 1:length(idxUserId), sep=''),
              item=movies$title[match(idxMovieId, movies$movieId)]
            ))

for (i in 1:nrow(ratings)) {
  rating <- ratings[i,]
  irow <- match(rating$userId, idxUserId)
  icol <- match(rating$movieId, idxMovieId)
  m[irow, icol] <- rating$rating
}
dim(m)

# convert to realRatingMatrix type
ratingMatrix <- as(m, "realRatingMatrix")

# use only movies with more than 100 ratings
Movie100 <- ratingMatrix[rowCounts(ratingMatrix) > 100, ]

# UBCF model and prediction
ubcf_recommender <- Recommender(Movie100[-1], method="UBCF")
# recommend top 5 movies for user 1
pred <- predict(ubcf_recommender, Movie100[1], n = 5)
as(pred, 'list')

# IBCF model and prediction
ibcf_recommender <- Recommender(Movie100[-1], method="IBCF")
# recommend top 5 movies for user 1
pred <- predict(ibcf_recommender, Movie100[1], n = 5)
as(pred, 'list')

